# Copy to Arcane project Environment (do not commit .env with real values).

# Tailscale sidecar — reusable, non-ephemeral auth key from admin console.
TS_AUTHKEY=tskey-auth-...

# Tribble PostgreSQL (1Password: Tribble DB Prod / Staging / Test)
TRIBBLE_PROD_DB_PASSWORD=
TRIBBLE_STAGING_DB_PASSWORD=
TRIBBLE_TEST_DB_PASSWORD=

# Presenton PostgreSQL URLs — postgresql:// not postgresql+asyncpg://
# 1Password: Presenton DB Prod / Staging / Test (field: credential)
PRESENTON_PROD_DATABASE_URL=
PRESENTON_STAGING_DATABASE_URL=
PRESENTON_TEST_DATABASE_URL=
